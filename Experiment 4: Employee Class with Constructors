#include <iostream>
using namespace std;

class Employee {
    private:
    int id;
    string name;
    float salary;
    float bonus;
    float totalsalary;

public:

    Employee()
    {
        id = 0;
        name = "Unknown";
        salary = 0;
        bonus = 0;
        totalsalary=0 ;

        cout << "Default constructor called" << endl;
    }
    Employee(int i, string m, float n, float a)
    {
        id = i;
        name = m;
        salary = n;
        bonus = a;

        cout << "Parameterized constructor called" << endl;
    }
    void myfunc(){
       totalsalary=salary+bonus;
       cout<<totalsalary<<endl;
    }

    void display()
    {
        cout << "Employee ID: " << id << endl;
        cout << "Name: " << name << endl;
        cout << "Basic Salary: " << salary << endl;
        cout << "Bonus: " << bonus << endl;
        cout << "Total Salary: ";
        myfunc();

    }
};

int main()
{
    Employee a1;

    a1.display();
    Employee a2(200 , "Aryan singh", 500000, 80000);

    a2.display();

    return 0;
}
